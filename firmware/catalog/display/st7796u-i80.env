HEADER=esp_lcd_st7796.h
INIT=esp_lcd_new_panel_st7796
REQUIRES_INPUT_GPIO=
REQUIRES_OUTPUT_GPIO=TFT_D0,TFT_D1,TFT_D2,TFT_D3,TFT_D4,TFT_D5,TFT_D6,TFT_D7,TFT_D8,TFT_D9,TFT_D10,TFT_D11,TFT_D12,TFT_D13,TFT_D14,TFT_D15,TFT_WR,TFT_CS,TFT_DC
WIDTH=320
HEIGHT=480
PIXEL_CLOCK_HZ=10000000
ROTATION=LANDSCAPE

SCHEMA_VERSION=1
ID=ili9341-spi
TARGETS=esp32,esp32c3,esp32s3,esp32p4
BUS=SPI
DATA_WIDTH=0
DRIVER=ILI9341
SIZE_INCH=2.4
COMPONENT=espressif/esp_lcd_ili9341
VERSION=2.0.2
CMAKE_COMPONENT=esp_lcd_ili9341
HEADER=esp_lcd_ili9341.h
INIT=esp_lcd_new_panel_ili9341

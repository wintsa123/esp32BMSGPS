SCHEMA_VERSION=1
ID=cst816s-i2c
TARGETS=esp32,esp32s3
BUS=I2C
DRIVER=CST816S
COMPONENT=espressif/esp_lcd_touch_cst816s
VERSION=1.1.1
CMAKE_COMPONENT=esp_lcd_touch_cst816s
HEADER=esp_lcd_touch_cst816s.h
INIT=esp_lcd_touch_new_i2c_cst816s
REQUIRES_INPUT_GPIO=TOUCH_INT
REQUIRES_OUTPUT_GPIO=TOUCH_SDA,TOUCH_SCL
USE_IRQ=1
SWAP_XY=1
MIRROR_X=0
MIRROR_Y=0
I2C_ADDRESS=21
I2C_CLOCK_HZ=100000
I2C_CONTROL_PHASE_BYTES=1
I2C_DC_BIT_OFFSET=0
I2C_CMD_BITS=8
I2C_PARAM_BITS=0
I2C_DISABLE_CONTROL_PHASE=1
I2C_INTERNAL_PULLUP=1
RESET_LEVEL=0
IRQ_LEVEL=0

SCHEMA_VERSION=1
ID=xpt2046-spi
TARGETS=esp32,esp32s3
BUS=SPI
DRIVER=XPT2046
COMPONENT=atanisoft/esp_lcd_touch_xpt2046
VERSION=1.0.6
CMAKE_COMPONENT=atanisoft__esp_lcd_touch_xpt2046
HEADER=esp_lcd_touch_xpt2046.h
INIT=esp_lcd_touch_new_spi_xpt2046
REQUIRES_INPUT_GPIO=TOUCH_MISO
REQUIRES_OUTPUT_GPIO=TOUCH_MOSI,TOUCH_CS,TOUCH_SCLK
USE_IRQ=0
SWAP_XY=1
MIRROR_X=0
MIRROR_Y=0
I2C_ADDRESS=0
I2C_CLOCK_HZ=0
I2C_CONTROL_PHASE_BYTES=0
I2C_DC_BIT_OFFSET=0
I2C_CMD_BITS=0
I2C_PARAM_BITS=0
I2C_DISABLE_CONTROL_PHASE=0
I2C_INTERNAL_PULLUP=0
RESET_LEVEL=0
IRQ_LEVEL=0

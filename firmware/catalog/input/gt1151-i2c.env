SCHEMA_VERSION=1
ID=gt1151-i2c
TARGETS=esp32,esp32c3,esp32s3,esp32p4
BUS=I2C
DRIVER=GT1151
COMPONENT=espressif/esp_lcd_touch_gt1151
VERSION=1.1.0
CMAKE_COMPONENT=esp_lcd_touch_gt1151
HEADER=esp_lcd_touch_gt1151.h
INIT=esp_lcd_touch_new_i2c_gt1151
REQUIRES_INPUT_GPIO=TOUCH_INT
REQUIRES_OUTPUT_GPIO=TOUCH_SDA,TOUCH_SCL
USE_IRQ=1
SWAP_XY=1
MIRROR_X=0
MIRROR_Y=0
I2C_ADDRESS=20
I2C_CLOCK_HZ=100000
I2C_CONTROL_PHASE_BYTES=1
I2C_DC_BIT_OFFSET=0
I2C_CMD_BITS=16
I2C_PARAM_BITS=8
I2C_DISABLE_CONTROL_PHASE=1
I2C_INTERNAL_PULLUP=1
RESET_LEVEL=0
IRQ_LEVEL=0

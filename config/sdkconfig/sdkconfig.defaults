CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESP32_REV_MIN_3=y
CONFIG_ESP32_REV_MIN=3
CONFIG_ESP32_REV_MIN_FULL=300
CONFIG_ESP_REV_MIN_FULL=300
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Runtime, NVS, and display startup exceed ESP-IDF's 3584-byte main task stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Shrink event and LWIP task stacks — default 2304/3072 wastes ~1.5 KB on
# this product's simple networking profile.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2560
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# ESP32-WROOM-32E has no external PSRAM. Keep this disabled so boot does not
# probe missing hardware and all memory budgets reflect internal SRAM only.
# CONFIG_SPIRAM is not set
# CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL is not set
# CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_DEFAULT=y
# Avoid a NULL NimBLE host context if an early directed advertising report arrives.
# CONFIG_BT_NIMBLE_STATIC_TO_DYNAMIC is not set
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
# CONFIG_BTDM_CTRL_MODEM_SLEEP is not set
# CONFIG_BTDM_CTRL_FULL_SCAN_SUPPORTED is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# Setup AP is WPA2-PSK only; station, enterprise, and WPA3-only code paths are unused.
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# SoftAP needs only 1 client, no 802.11n block ack.
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=1
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=8
CONFIG_LWIP_MAX_ACTIVE_TCP=4
CONFIG_LWIP_MAX_LISTENING_TCP=2
CONFIG_LWIP_MAX_UDP_PCBS=4
CONFIG_LWIP_MAX_RAW_PCBS=2
# Reduce per-socket TCP buffer memory: each socket pair uses SND+WND bytes.
# 2880 = 2*MSS at MSS=1440; enough for the small JSON API and web page.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_OVERSIZE_QUARTER_MSS=y
# CONFIG_LWIP_TCP_OVERSIZE_MSS is not set
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_ENCRYPTION=y
CONFIG_BT_NIMBLE_SM_LVL=2
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_MAX_CCCDS=4
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=2
# GAP supplies the device name and advertising. The product uses no optional
# standard GATT services, only its existing central/peripheral protocol.
# CONFIG_BT_NIMBLE_PROX_SERVICE is not set
# CONFIG_BT_NIMBLE_ANS_SERVICE is not set
# CONFIG_BT_NIMBLE_CTS_SERVICE is not set
# CONFIG_BT_NIMBLE_HTP_SERVICE is not set
# CONFIG_BT_NIMBLE_IPSS_SERVICE is not set
# CONFIG_BT_NIMBLE_TPS_SERVICE is not set
# CONFIG_BT_NIMBLE_IAS_SERVICE is not set
# CONFIG_BT_NIMBLE_LLS_SERVICE is not set
# CONFIG_BT_NIMBLE_SPS_SERVICE is not set
# CONFIG_BT_NIMBLE_HR_SERVICE is not set
# CONFIG_BT_NIMBLE_BAS_SERVICE is not set
# CONFIG_BT_NIMBLE_DIS_SERVICE is not set
# CONFIG_BT_NIMBLE_DTM_MODE_TEST is not set

# SoftAP plus LVGL uses the 4 MB custom dual app-slot partition layout.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE is not set

CONFIG_LV_CONF_SKIP=y
CONFIG_LV_CONF_MINIMAL=y
# The minimal LVGL preset otherwise defaults to ASCII and turns Chinese plus
# icon UTF-8 glyphs into placeholders.
CONFIG_LV_TXT_ENC_UTF8=y
# CONFIG_LV_TXT_ENC_ASCII is not set
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_FREERTOS_TASK_NOTIFY=y
# A second 8 KB draw-thread stack leaves legacy ESP32 without enough heap for
# on-demand Wi-Fi or NimBLE startup. PSRAM-capable MCUs use separate defaults.
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# 20 ms refresh (50 Hz) saves CPU wake-ups vs 10 ms; imperceptible on this UI.
CONFIG_LV_DEF_REFR_PERIOD=20
# Style cache uses ~32 B per widget; with 58+ widgets the cost exceeds its
# lookup-time benefit on this static dashboard UI.
# CONFIG_LV_OBJ_STYLE_CACHE is not set
CONFIG_LV_DRAW_SW_SUPPORT_RGB565=y
CONFIG_LV_DRAW_SW_SUPPORT_RGB565_SWAPPED=y
# QR code and text rendering require I1/A8; custom dashboard canvases require
# ARGB8888. Other software pixel formats are not used by the product.
# CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_RGB888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888 is not set
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888=y
# CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_L8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_AL88 is not set
CONFIG_LV_DRAW_SW_SUPPORT_A8=y
CONFIG_LV_DRAW_SW_SUPPORT_I1=y
# Shrink layer temp buffer: the only partial-opa usage is a toast overlay and
# one disabled-state box. 8 KiB handles <=160 px wide ARGB8888 strips.
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=8192
# Reduce LV_MEM from 64 KiB to 48 KiB.  The UI creates ~58 widgets with
# fixed-position labels; style, obj and animation pools fit well within 48 KiB
# and the freed 16 KiB stays available for Wi-Fi/BLE on-demand allocations.
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# --- Widgets: enable only what the product uses --------------------------
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_ARC=y
CONFIG_LV_USE_IMAGE=y
CONFIG_LV_USE_LINE=y
CONFIG_LV_USE_ROLLER=y
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_BAR is not set
# CONFIG_LV_USE_BUTTON is not set
# CONFIG_LV_USE_BUTTONMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SLIDER is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_SPINNER is not set
# CONFIG_LV_USE_SWITCH is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARCLABEL is not set
# Flex is used once (range_group); grid is unused.
CONFIG_LV_USE_FLEX=y
# CONFIG_LV_USE_GRID is not set
# Observer pattern unused; disable to save per-obj pointer slot.
# CONFIG_LV_USE_OBSERVER is not set
# Themes add default styles to every widget; the product applies styles
# manually, so disable both to save code and per-create overhead.
# CONFIG_LV_USE_THEME_DEFAULT is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set
CONFIG_LV_USE_QRCODE=y
# Keep enough internal heap for static NimBLE HCI pools on ESP32 without PSRAM.
# 20 rows × 320 px × 2 B = 12.8 KiB (was 17.5 KiB at 28 rows).
CONFIG_ESP_BMS_LVGL_BRIDGE_SPI_DRAW_BUFFER_HEIGHT=20
CONFIG_ESP_BMS_LVGL_BRIDGE_TASK_MAX_DELAY_MS=5
# CONFIG_ESP_BMS_LVGL_BRIDGE_DOUBLE_BUFFER is not set
# CONFIG_ESP_BMS_LVGL_UI_DRAG_FULL_INVALIDATE is not set
# CONFIG_ESP_BMS_LVGL_UI_DRAG_DIAGNOSTICS is not set

# Keep the IDF display bring-up image small and focused.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_FREETYPE is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_BUTTON is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_KNOB is not set
CONFIG_HTTPD_WS_SUPPORT=y
# Shrink HTTP server per-connection overhead: the AP serves a single client
# with short URIs and minimal headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_HTTPD_MAX_URI_LEN=128
